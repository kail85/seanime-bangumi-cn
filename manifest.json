{
  "id": "seanime-bangumi-cn",
  "name": "Bangumi Simplified Chinese Metadata",
  "version": "1.0.1",
  "manifestURI": "https://raw.githubusercontent.com/kail85/seanime-bangumi-cn/main/manifest.json",
  "language": "javascript",
  "type": "plugin",
  "description": "Decorates existing AniList anime with confident Bangumi Chinese titles and summaries.",
  "author": "kail85",
  "website": "https://github.com/kail85/seanime-bangumi-cn",
  "readme": "https://github.com/kail85/seanime-bangumi-cn/blob/main/README.md",
  "lang": "zh",
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": ["storage"],
      "allow": {
        "networkAccess": {
          "allowedDomains": ["api.bgm.tv"],
          "reasoning": "Fetch public Bangumi anime metadata for display-only enrichment."
        }
      }
    }
  },
  "payloadURI": "https://raw.githubusercontent.com/kail85/seanime-bangumi-cn/main/code.js?v=1.0.1"
}
